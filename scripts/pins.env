# =====================================================================
# pins.env — stable 分支：全部钉死（只有手动改本文件才会变）
#   - 每一行 KEY=VALUE；本分支刻意不留空（置空=跟踪上游最新，那是 latest 分支的事）。
#   - 同名环境变量可覆盖此处取值（CI 未覆盖）。
#   - 升级流程：改一行 → push → 自检门禁（1–2 分钟）→ 手动跑 build。
# =====================================================================

# ---- KernelSU（ReSukiSU）----
# 2026-09-17 latest 实测版（118/89 双构建全绿；含 susfs_*_no_su helpers）。
KSU_REPO=ReSukiSU/ReSukiSU
KSU_REF=6ec8d9a8a8be30878c388504cacf8ae7849c757b

# ---- SUSFS 内核侧补丁源（simonpunk/susfs4ksu, gitlab）----
# 2026-09-17 latest 实测版（50_@72997d3）：6.6.118 fuzz=0 零拒绝；6.6.89 一处预期拒绝
# （fs/proc/base.c）+ patches/89-susfs-fixup.patch 完成集成。
SUSFS_HOST=gitlab.com
SUSFS_REPO=simonpunk/susfs4ksu
SUSFS_BRANCH=gki-android15-6.6
SUSFS_SHA=72997d308cf0d55003ad4695ebde130ef9fc5201

# ---- 通用补丁仓库（CVE/display/fengchi/droidspace/lz4kd/ZRAM-lib 等）----
KERNEL_PATCHES_REPO=luyancib-org/kernel_patches
KERNEL_PATCHES_SHA=3e36443e8b31b90c5aa8b1aa0d0250ad259bfd97

# ---- KPM（KPatch-Next 后置注入，全 KSU 变体可用）----
KPATCH_REPO=KernelSU-Next/KPatch-Next
KPATCH_TAG=0.13.5-2

# ---- Baseband-guard（stable：钉死；与 #21/#23 构建同源）----
BBG_REPO=vc-teahouse/Baseband-guard
BBG_REF=a54e0dc6cf0aff4dd87fec49644a02d2eb612905

# ---- NTSync（Droidspaces）----
NTSC_REPO=Goldzxcbug/Droidspaces_Kernel_patch
NTSC_SHA=d8bf6769d0d5781d17701625a4dd8de42267768d

# ---- 其它（hookless hooks；该功能未启用）----
SUKI_HOOKS_REPO=SukiSU-Ultra/SukiSU_patch
