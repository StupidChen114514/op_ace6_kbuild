# =====================================================================
# pins.env — 版本钉死配置（configure 读取）
#   - 每一行 KEY=VALUE；置空表示"跟踪上游最新分支"。
#   - 同名环境变量可覆盖此处取值。
#   - 修改后请一并更新 build_manifest.txt 的审查（CI 会自动记录实际解析到的 SHA）。
# =====================================================================

# ---- KernelSU（ReSukiSU）----
KSU_REPO=ReSukiSU/ReSukiSU
KSU_REF=

# ---- SUSFS 内核侧补丁源（simonpunk/susfs4ksu, gitlab）----
# 该 SHA 为 2026-09-15 实测版本：6.6.118 干净可打；6.6.89 配合 patches/89-susfs-fixup.patch 完成集成。
SUSFS_HOST=gitlab.com
SUSFS_REPO=simonpunk/susfs4ksu
SUSFS_BRANCH=gki-android15-6.6
SUSFS_SHA=01677642e6ade3b9e56e0a8660192a664dad79e9

# ---- 通用补丁仓库（CVE/display/fengchi/droidspace/lz4kd/hookless 等）----
KERNEL_PATCHES_REPO=luyancib-org/kernel_patches
KERNEL_PATCHES_SHA=3e36443e8b31b90c5aa8b1aa0d0250ad259bfd97

# ---- ZRAM LZ4 补丁源 ----
ZRAM_PATCH_REPO=cctv18/oppo_oplus_realme_sm8750
ZRAM_PATCH_SHA=21db9e7d547ca625bd5aa734fb5dfc8b94ea48ef

# ---- Baseband-guard ----
BBG_REPO=vc-teahouse/Baseband-guard
BBG_REF=

# ---- NTSync（Droidspaces）----
NTSC_REPO=Goldzxcbug/Droidspaces_Kernel_patch
NTSC_SHA=d8bf6769d0d5781d17701625a4dd8de42267768d

# ---- 其它 ----
SUKI_HOOKS_REPO=SukiSU-Ultra/SukiSU_patch
