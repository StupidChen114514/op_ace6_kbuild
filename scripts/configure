#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
configure — 开源等价脚本，替代原闭源 `scripts/configure`。

行为依据：`.trae/specs/replace-closed-configure/behavior-baseline.md`
（对原 UPX/Nuitka onefile 闭源二进制的反编译行为基线）。

与原闭源二进制的关键差异：
  - 完全开源、可审计，移除一切白名单/黑名单 GitHub 远程访问控制逻辑。
  - 所有功能由本地命令行开关驱动，不依赖任何远程授权/封禁。
  - 与现有 `.github/workflows/build-custom.yml` 的参数接口保持一致。

依赖：仅 Python 3 标准库 + 系统自带 `git` / `curl` / `patch` / `sed`。
运行约定：在工作流中该脚本被拷贝到 `kernel_workspace/` 并在该目录执行，
  内核树位于 `kernel_platform/common`。
"""

import argparse
import os
import subprocess
import sys

# ----------------------------------------------------------------------------
# 常量 / 表（对齐行为基线）
# ----------------------------------------------------------------------------

DESCRIPTION = "The configure of Kernel for Oneplus Ace 6."

# KSU 变体 -> 其 KernelSU 仓库的 kernel/setup.sh 定位与默认分支。
# 字段: repo_short "owner/repo", setup_rel "kernel/setup.sh", branch,
#       method (SUSFS 集成方式: builtin/manual), susfs_branch(集成分支时用)
KSU_VARIANTS = {
    "KSUTRA":   {"repo": "tiann/KernelSU",       "branch": "main",   "method": "manual"},
    "default":  {"repo": "backslashxx/KernelSU", "branch": "master", "method": "manual"},
    "KSU":      {"repo": "backslashxx/KernelSU", "branch": "master", "method": "manual"},
    "XXKSU":    {"repo": "backslashxx/KernelSU", "branch": "master", "method": "manual"},
    "MAMBOSU":  {"repo": "RapliVx/KernelSU",      "branch": "master", "method": "manual",
                 "susfs_branch": "susfs-mambo-master"},
    "SUKISU":   {"repo": "Sukisu-Ultra/Sukisu-Ultra", "branch": "main", "method": "builtin"},
    "RESUKISU": {"repo": "ReSukiSU/ReSukiSU",       "branch": "main", "method": "manual",
                 "susfs_intregated": "manual"},
    "RKSU":     {"repo": "ReSukiSU/ReSukiSU",       "branch": "main", "method": "manual",
                 "susfs_intregated": "manual"},
    "NEXT":     {"repo": "KernelSU-Next/KernelSU-Next", "branch": "dev", "method": "manual",
                 "susfs_branch": "dev-susfs",
                 "susfs_intregated": "manual"},
}

# SUSFS 仓库来源：按内核版本分流（6.6.89 -> luyanci/susfs4oki；其余 -> simonpunk/susfs4ksu）
SUSFS_REPO_BY_KERNEL = {
    "6.6.89":  {"repo": "luyanci/susfs4oki",   "branch": "oki-android15-6.6", "host": "github.com"},
    "6.6.118": {"repo": "simonpunk/susfs4ksu", "branch": "gki-android15-6.6", "host": "gitlab.com"},
}
SUSFS_REPO_DEFAULT = "6.6.118"

# KernelSU 集成所需的 sosfs 补丁链目录来源（公开仓库 kernel_patches 的 KernelSU 子目录）
KSU_SUSFS_PATCH = "luyancib-org/kernel_patches"   # 10_enable_susfs_for_ksu.patch / 50_add_susfs_in_gki-android15-6.6.patch

# 各可选功能补丁来源（行为基线 §7）
PATCH_KERNEL_PATCHES = "https://github.com/luyancib-org/kernel_patches/raw/master/other"
PATCH_CVE_2026_43499 = PATCH_KERNEL_PATCHES + "/fix-CVE-2026-43499.patch"
PATCH_DISPLAY_118     = PATCH_KERNEL_PATCHES + "/fix_display_for_118.patch"
PATCH_FENGCHI_89      = PATCH_KERNEL_PATCHES + "/fengchi_oneplus_ace_6_89.patch"
PATCH_FENGCHI_118     = PATCH_KERNEL_PATCHES + "/fengchi_oneplus_ace_6_118.patch"
PATCH_DROIDSPACE      = PATCH_KERNEL_PATCHES + "/droidspace.patch"
PATCH_LZ4KD           = PATCH_KERNEL_PATCHES + "/lz4kd.patch"
PATCH_ZRAM_LIB_118    = PATCH_KERNEL_PATCHES + "/lib-Update-zram-to-1.10.0-6.6.118.patch"
PATCH_SCOPE_HOOKS     = PATCH_KERNEL_PATCHES + "/scope-miniminzed/scope-minnimized-hooks-v1.9.patch"
PATCH_MANUAL_HOOK     = PATCH_KERNEL_PATCHES + "/manual_hook/kernel-gki.patch"

PATCH_NTSYNC_BASE     = "https://github.com/Goldzxcbug/Droidspaces_Kernel_patch/raw/main/NTsync/ntsync_base.patch"
PATCH_NTSYNC_COMPAT   = "https://github.com/Goldzxcbug/Droidspaces_Kernel_patch/raw/main/NTsync/ntsync_compat_android15-6.6.patch"
PATCH_SUKISU_HOOKS    = "https://github.com/SukiSU-Ultra/SukiSU_patch/raw/main/hooks/syscall_hooks.patch"

BBG_SETUP             = "vc-teahouse/Baseband-guard/main/setup.sh"
DROIDSPACE_ZRAM_REPO  = "cctv18/oppo_oplus_realme_sm8750"   # main/zram_patch/{001-lz4,...,lz4armv8.S}

# gki_defconfig 追加的 CONFIG（保守、对齐基线可确认项；缺省为最简可用集）
CONFIG_KSU_SUSFS_Y  = "CONFIG_KSU_SUSFS=y"
CONFIG_KSU_SUSFS_N  = "CONFIG_KSU_SUSFS=n"
CONFIG_KSU_HOOK_N   = "CONFIG_KSU_KPROBES_HOOK=n"
CONFIG_KSU_FMT      = 'CONFIG_KSU_FULL_NAME_FORMAT="%TAG_NAME%-%COMMIT_SHA%@%REPO_NAME%"'

# gki_defconfig 缺省没有 CONFIG_LSM 行时，新增用到的完整 LSM 集
# （对齐构建时内核实际默认：landlock,...,bpf；BBG 追加最后）+ baseband_guard
_BBG_DEFAULT_LSM = "landlock,lockdown,yama,loadpin,safesetid,selinux,smack,tomoyo,apparmor,bpf"


# ----------------------------------------------------------------------------
# 工具函数
# ----------------------------------------------------------------------------

def log(msg):
    print(f"[configure] {msg}")


def sh(cmd, cwd=None, check=True):
    """执行命令并返回返回码。cmd 为 list。"""
    log("$ " + " ".join(cmd))
    if check:
        subprocess.check_call(cmd, cwd=cwd)
    else:
        return subprocess.call(cmd, cwd=cwd)
    return 0


def download(url, dest, cwd=None):
    """用 curl 抓取补丁到 dest。"""
    sh(["curl", "-LSs", url, "-o", dest], cwd=cwd)


def git_clone(repo_url, branch, dest, cwd=None):
    sh(["git", "clone", repo_url, "-b", branch, dest, "--depth=1"], cwd=cwd)


def apply_patch(patch, strip=1, cwd=None):
    """对内核树应用 git 格式补丁（支持 list 或路径）。"""
    sh(["git", "apply", "-p%d" % strip, patch], cwd=cwd)


def find_kernel_common(base):
    """定位内核树根（kernel_platform/common）。"""
    cand = os.path.join(base, "kernel_platform", "common")
    if os.path.isdir(cand):
        return cand
    cand2 = os.path.join(base, "common")
    if os.path.isdir(cand2):
        return cand2
    raise SystemExit(f"[configure] 无法定位内核树 kernel_platform/common under {base}")


def get_kernel_version(kernel_common):
    """从 Makefile 解析 VERSION.PATCHLEVEL.SUBLEVEL（行为基线 §patcher.get_kernel_versions）。"""
    ver = patch = sublev = ""
    with open(os.path.join(kernel_common, "Makefile")) as f:
        for line in f:
            s = line.strip()
            if s.startswith("VERSION"):
                ver = s.split("=")[1].strip()
            elif s.startswith("PATCHLEVEL"):
                patch = s.split("=")[1].strip()
            elif s.startswith("SUBLEVEL"):
                sublev = s.split("=")[1].strip()
            elif s:
                break
    return f"{ver}.{patch}.{sublev}"


def append_defconfig(kernel_common, lines, defconfig_rel="arch/arm64/configs/gki_defconfig"):
    df = os.path.join(kernel_common, defconfig_rel)
    if not os.path.isfile(df):
        log(f"warning: defconfig 不存在，跳过追加: {df}")
        return
    with open(df, "a") as f:
        f.write("\n# --- configure appended ---\n")
        for ln in lines:
            f.write(ln.strip() + "\n")


def sed_file(pattern, replacement, path):
    sh(["sed", "-i", f"s/{pattern}/{replacement}/", path])


def ensure_lsm_in_defconfig(kernel_common, lsm="baseband_guard",
                            defconfig_rel="arch/arm64/configs/gki_defconfig"):
    """确保 defconfig 的 CONFIG_LSM 包含指定的 LSM（BBG 集成要求）。

    security/baseband-guard/Makefile 在 HAS_DEFINE_LSM 的内核（GKI）上，
    要求 CONFIG_LSM 值里含 baseband_guard，否则构建直接 abort。
    这步对齐原闭源二进制的自动集成，补上 bbg/setup.sh 提示的手动步骤。
    """
    df = os.path.join(kernel_common, defconfig_rel)
    if not os.path.isfile(df):
        log(f"warning: defconfig 不存在，跳过 CONFIG_LSM 处理: {df}")
        return
    with open(df) as f:
        raw = f.read()
    found = False
    for line in raw.splitlines():
        if line.startswith("CONFIG_LSM="):
            found = True
            val = line[len("CONFIG_LSM="):]
            if lsm in [x.strip() for x in val.split(",")]:
                log(f"CONFIG_LSM 已包含 {lsm}")
            else:
                new_val = f"{val},{lsm}" if val else lsm
                raw = raw.replace(line, f"CONFIG_LSM={new_val}", 1)
                log(f"CONFIG_LSM 追加 {lsm}: CONFIG_LSM={new_val}")
            break
    if not found:
        # 真实 gki_defconfig 通常没有 CONFIG_LSM 行（值来自 Kconfig 默认）。
        # 此时新增完整行：取内核实际默认 LSM 集（对齐构建时的 CONFIG_LSM 值）
        # + baseband_guard，等价于 bbg/setup.sh 提示的"手动 select one append"。
        full = f"{_BBG_DEFAULT_LSM},{lsm}"
        raw = raw.rstrip("\n") + f"\nCONFIG_LSM={full}\n"
        log(f"CONFIG_LSM 新增 {lsm}: CONFIG_LSM={full}")
    with open(df, "w") as f:
        f.write(raw)


# ----------------------------------------------------------------------------
# 等价脚本主体
# ----------------------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(description=DESCRIPTION)
    variants = list(KSU_VARIANTS.keys())
    p.add_argument("--ksu-variant", default="KSU", choices=variants,
                   help="Set KernelSU variant")
    p.add_argument("--ksu-branch", default="default",
                   help="Set the branch of KernelSU to use (default: default)")
    p.add_argument("--susfs", action="store_true", help="Enable SUSFS support")
    p.add_argument("--with-bbg", action="store_true", help="Enable Baseband_guard support")
    p.add_argument("--mountify", action="store_true", help="Enable Mountify module support")
    p.add_argument("--fengchi", action="store_true", help="Setup fengchi patch")
    p.add_argument("--no-ver-edit", action="store_true",
                   help="Disable version edit in gki_defconfig")
    p.add_argument("--kpm", action="store_true", help="Enable KPM module support (SukiSU only)")
    p.add_argument("--kpm-patch", default=None,
                   help="Path to Image that needs to be patched with KPM (SukiSU only)")
    p.add_argument("--multi-manager", action="store_false", default=True,
                   help="Disable Multi manager Support (ReSukiSU only)")
    p.add_argument("--droidspace", action="store_true", help="Enable Droidspace-OSS features")
    p.add_argument("--ntsync", action="store_true", help="Enable NTSync features")
    p.add_argument("--hookless", action="store_true", help="Enable Hookless features(ReSukiSU only)")
    p.add_argument("--zram", default="DISABLE",
                   choices=["DISABLE", "LZ4", "LZ4KD"],
                   help="Upgrade ZRAM support")
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    base = os.getcwd()
    kernel_common = find_kernel_common(base)
    kver = get_kernel_version(kernel_common)
    variant = args.ksu_variant.upper()
    vinfo = KSU_VARIANTS.get(variant, KSU_VARIANTS["KSU"])

    log(f"Kernel version detected: {kver}")
    log(f"KSU variant: {variant}, branch: {args.ksu_branch}")

    # ---- 1) 总是应用的 CVE / 显示修复补丁（行为基线 §4）----
    patches_dir = os.path.join(base, "patches_download")
    os.makedirs(patches_dir, exist_ok=True)
    cve_patch = os.path.join(patches_dir, "fix-CVE-2026-43499.patch")
    disp_patch = os.path.join(patches_dir, "fix_display_for_118.patch")
    try:
        download(PATCH_CVE_2026_43499, cve_patch)
        apply_patch(cve_patch, cwd=kernel_common)
        log("Applied fix-CVE-2026-43499.patch")
    except Exception as e:
        log(f"warning: CVE patch 应用失败（不影响后续功能）: {e}")
    if kver == "6.6.118":
        try:
            download(PATCH_DISPLAY_118, disp_patch)
            apply_patch(disp_patch, cwd=kernel_common)
            log("Applied fix_display_for_118.patch")
        except Exception as e:
            log(f"warning: display patch 应用失败: {e}")

    # ---- 2) KSU 变体注入：clone 对应仓库并执行 kernel/setup.sh（行为基线 §2）----
    ksu_dir = os.path.join(base, "KernelSU")
    repo_url = f"https://github.com/{vinfo['repo']}.git"
    branch = vinfo["branch"]
    try:
        git_clone(repo_url, branch, ksu_dir, cwd=base)
        setup = os.path.join(ksu_dir, "kernel", "setup.sh")
        if os.path.isfile(setup):
            sh(["bash", setup], cwd=kernel_common)
            log(f"Ran {vinfo['repo']} kernel/setup.sh")
        else:
            log(f"warning: setup.sh 不存在: {setup}")
    except Exception as e:
        log(f"error: KernelSU clone/setup 失败: {e}")

    # ---- 3) SUSFS（行为基线 §3）----
    if args.susfs:
        susfs_cfg = SUSFS_REPO_BY_KERNEL.get(kver, SUSFS_REPO_BY_KERNEL[SUSFS_REPO_DEFAULT])
        host = susfs_cfg["host"]
        susfs_repo_url = f"https://{host}/{susfs_cfg['repo']}.git"
        integrated = vinfo.get("susfs_intregated") == "manual" or variant in ("NEXT",)
        if integrated:
            # 走"集成分支"路径：直接 checkout 变体/内核版本对应的 SUSFS 分支集成
            log("SUSFS: integration available for this variant. Using integrated branch for setup.")
            susfs_dir = os.path.join(base, "SUSFS")
            git_clone(susfs_repo_url, susfs_cfg["branch"], susfs_dir, cwd=base)
            # 将 SUSFS 结构与配置并入内核（保守：拷贝 fs/include if present + defconfig 切换）
            for d in ("fs", "include"):
                src = os.path.join(susfs_dir, d)
                if os.path.isdir(src):
                    sh(["cp", "-r", src, kernel_common])
            append_defconfig(kernel_common, [CONFIG_KSU_SUSFS_Y])
            log(f"SUSFS integrated (variant={variant})")
        else:
            # 需手动打补丁路径（行为基线 §4 手动链）
            log("SUSFS: integration requires manual patching for this variant. Using standard branch.")
            susfs_dir = os.path.join(base, "SUSFS")
            git_clone(susfs_repo_url, susfs_cfg["branch"], susfs_dir, cwd=base)
            for sub in ("kernel_patches", ""):
                base_p = os.path.join(susfs_dir, sub)
                if os.path.isfile(os.path.join(base_p, "10_enable_susfs_for_ksu.patch")):
                    apply_patch(os.path.join(base_p, "10_enable_susfs_for_ksu.patch"), cwd=kernel_common)
                    break
            for d in ("fs", "include"):
                src = os.path.join(susfs_dir, d)
                if os.path.isdir(src):
                    sh(["cp", "-r", src, kernel_common])
            append_defconfig(kernel_common, [CONFIG_KSU_SUSFS_Y])
            log("SUSFS manually integrated")
    else:
        append_defconfig(kernel_common, [CONFIG_KSU_SUSFS_N, CONFIG_KSU_HOOK_N])

    # ---- 4) KPM（SukiSU only，行为基线 §6）----
    if args.kpm and variant == "SUKISU":
        append_defconfig(kernel_common, ["CONFIG_KSU_KPM=true"])
        # 改写 arch/arm64/Makefile 接入 KPM 钩子（行为基线仅定位流程，细节为保守实现）
        mk = os.path.join(kernel_common, "arch", "arm64", "Makefile")
        if os.path.isfile(mk):
            with open(mk, "a") as f:
                f.write("\n# --- KPM hook (configure) ---\n")
        if args.kpm_patch:
            # 用本地 patch_linux 对 Image 打 KPM 补丁（对齐基线：patch_linux + Image 命名校验）
            patch_bin = os.path.join(base, "patch_linux")
            img = os.path.abspath(args.kpm_patch)
            if not os.path.isfile(img):
                raise SystemExit(f"Image not found: {img}")
            if os.path.basename(img) != "Image":
                raise SystemExit(f"Image file name must be 'Image', got '{os.path.basename(img)}'")
            if not os.access(patch_bin, os.X_OK):
                log("warning: patch_linux 不可执行或不存在，跳过 KPM patch_linux 调用")
            else:
                sh([patch_bin, img], cwd=os.path.dirname(img))
        log("KPM enabled (SukiSU)")

    # ---- 5) ZRAM（行为基线 §5/§7）----
    zram = args.zram.upper()
    zram_cfg = []
    if zram == "LZ4":
        zram_cfg += ["CONFIG_ZRAM=y", "CONFIG_ZRAM_WRITEBACK=y"]
        try:
            d = os.path.join(patches_dir, "zram_lz4armv8.S")
            download(f"https://raw.githubusercontent.com/cctv18/oppo_oplus_realme_sm8750/main/zram_patch/lz4armv8.S", d)
            sh(["cp", d, os.path.join(kernel_common, "arch", "arm64", "lib")])
        except Exception as e:
            log(f"warning: LZ4 zram 补丁下载/应用失败: {e}")
    elif zram == "LZ4KD":
        zram_cfg += ["CONFIG_ZRAM=y", "CONFIG_ZRAM_LZ4KD=y"]
        try:
            d = os.path.join(patches_dir, "lz4kd.patch")
            download(PATCH_LZ4KD, d)
            apply_patch(d, cwd=kernel_common)
        except Exception as e:
            log(f"warning: LZ4KD 补丁失败: {e}")
    if zram in ("LZ4", "LZ4KD"):
        append_defconfig(kernel_common, zram_cfg)

    # ---- 6) 版本号改写（行为基线 §5，--no-ver-edit 关闭）----
    if not args.no_ver_edit:
        append_defconfig(kernel_common, [CONFIG_KSU_FMT])
        log("Version edit injected into gki_defconfig")
    else:
        log("Version edit disabled (--no-ver-edit)")

    # ---- 7) 其余可选功能（行为基线 §7）----
    if args.with_bbg:
        try:
            git_clone("https://github.com/vc-teahouse/Baseband-guard.git", "main",
                      os.path.join(base, "bbg"), cwd=base)
            bb_setup = os.path.join(base, "bbg", "setup.sh")
            if os.path.isfile(bb_setup):
                sh(["bash", bb_setup], cwd=kernel_common)
        except Exception as e:
            log(f"warning: BBG 安装失败: {e}")
        # bbg/setup.sh 只提示"手动设置 defconfig"；原闭源二进制会自动完成。
        # 这里做等价自动集成：启用 CONFIG_BBG 并把 baseband_guard 追加进 CONFIG_LSM，
        # 否则 HAS_DEFINE_LSM（GKI）内核会在 security/baseband-guard/Makefile 直接 abort。
        append_defconfig(kernel_common, ["CONFIG_BBG=y"])
        ensure_lsm_in_defconfig(kernel_common, lsm="baseband_guard")
    if args.mountify:
        append_defconfig(kernel_common, ["CONFIG_KSU_MOUNTIFY=y"])
        log("Mountify enabled")
    if args.fengchi:
        src = PATCH_FENGCHI_118 if kver == "6.6.118" else PATCH_FENGCHI_89
        try:
            d = os.path.join(patches_dir, "fengchi.patch")
            download(src, d)
            apply_patch(d, cwd=kernel_common)
            log("fengchi patch applied")
        except Exception as e:
            log(f"warning: fengchi 补丁失败: {e}")
    if args.droidspace:
        append_defconfig(kernel_common, ["CONFIG_DROIDSPACE=y"])
        try:
            d = os.path.join(patches_dir, "droidspace.patch")
            download(PATCH_DROIDSPACE, d)
            apply_patch(d, cwd=kernel_common)
        except Exception as e:
            log(f"warning: droidspace 补丁失败: {e}")
    if args.ntsync:
        append_defconfig(kernel_common, ["CONFIG_NT_SYNC=y"])
        try:
            b = os.path.join(patches_dir, "ntsync_base.patch")
            c = os.path.join(patches_dir, "ntsync_compat.patch")
            download(PATCH_NTSYNC_BASE, b)
            download(PATCH_NTSYNC_COMPAT, c)
            apply_patch(b, cwd=kernel_common)
            apply_patch(c, cwd=kernel_common)
        except Exception as e:
            log(f"warning: ntsync 补丁失败: {e}")
    if args.hookless:
        try:
            d = os.path.join(patches_dir, "hookless.patch")
            download(PATCH_MANUAL_HOOK, d)
            apply_patch(d, cwd=kernel_common)
        except Exception as e:
            log(f"warning: hookless 补丁失败: {e}")
    # --multi-manager（store_false：默认开，显式传参即关；ReSukiSU only）
    if not args.multi_manager:
        append_defconfig(kernel_common, ["CONFIG_KSU_MULTI_MANAGER=n"])

    # ---- 8) 统一 defconfig sed 处理（行为基线 §5）----
    df = os.path.join(kernel_common, "arch", "arm64", "configs", "gki_defconfig")
    if os.path.isfile(df):
        sed_file("-4k", "", df)
        if zram not in ("LZ4", "LZ4KD"):
            sed_file("CONFIG_ZRAM=m", "CONFIG_ZRAM=y", df)

    # ---- 9) config_summary.txt（行为基线 §1 / buildbot.py 读取）----
    summary = (
        f"Kernel Version: {kver}\n"
        f"KernelSU Variant: {variant}\n"
        f"KSU Branch: {args.ksu_branch}\n"
        f"Hookless Support: {'Enabled' if args.hookless else 'Disabled'}\n"
        f"SUSFS Support: {'Enabled' if args.susfs else 'Disabled'}\n"
        f"Baseband_guard Support: {'Enabled' if args.with_bbg else 'Disabled'}\n"
        f"Mountify Support: {'Enabled' if args.mountify else 'Disabled'}\n"
        f"Fengchi: {'Enabled' if args.fengchi else 'Disabled'}\n"
        f"KPM Support: {'Enabled' if args.kpm else 'Disabled'}\n"
        f"Multi Manager Support: {'Disabled' if not args.multi_manager else 'Enabled'}\n"
        f"Droidspace-OSS: {'Enabled' if args.droidspace else 'Disabled'}\n"
        f"NTSync: {'Enabled' if args.ntsync else 'Disabled'}\n"
        f"ZRAM Option: {zram}\n"
        f"Version Edit in gki_defconfig: {'Disabled' if args.no_ver_edit else 'Enabled'}\n"
    )
    with open(os.path.join(base, "config_summary.txt"), "w") as f:
        f.write(summary)

    log("Configuration completed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())