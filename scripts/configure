STATE = {"degraded": [], "manifest": []}

# ---------------------------------------------------------------------------
# 基础工具
# ---------------------------------------------------------------------------


def log(msg):
    print(f"[configure] {msg}", flush=True)


def fail(msg):
    if ALLOW_DEGRADED:
        warn(f"(degraded) {msg}")
        return
    log(f"[FATAL] {msg}")
    log("Configuration aborted.")
    sys.exit(1)


def warn(msg):
    log(f"[WARN] {msg}")
    STATE["degraded"].append(msg)


def manifest(line):
    STATE["manifest"].append(line)
    print(f"[manifest] {line}", flush=True)


def run(cmd, cwd=None, check=True, capture=False):
    log("$ " + " ".join(cmd))
    if capture:
        p = subprocess.run(cmd, cwd=cwd, stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT, text=True)
        return p.returncode, p.stdout
    if check:
        subprocess.check_call(cmd, cwd=cwd)
        return 0, ""
    return subprocess.call(cmd, cwd=cwd), ""


def read_text(path):
    try:
        return open(path, encoding="utf-8", errors="replace").read()
    except (FileNotFoundError, IsADirectoryError):
        return ""


def grep_count(path, needle):
    return read_text(path).count(needle)


def os_download(url, dest):
    log(f"download: {url}")
    req = urllib.request.Request(url, headers={"User-Agent": f"op_ace6_configure/{CONFIGURE_VERSION}"})
    with urllib.request.urlopen(req, timeout=180) as r, open(dest, "wb") as f:
        shutil.copyfileobj(r, f)


def raw_url(host, repo, ref, path):
    if host == "gitlab.com":
        return f"https://gitlab.com/{repo}/-/raw/{ref}/{path}"
    return f"https://raw.githubusercontent.com/{repo}/{ref}/{path}"


def fetch_source_tree(host, repo, branch, sha, dest, label):
    """获取补丁源仓库快照（优先按 SHA 的 tarball；否则 clone 分支）。"""
    if os.path.isdir(dest):
        shutil.rmtree(dest)
    ref = sha if sha else branch
    if host == "gitlab.com":
        tarball_url = f"https://gitlab.com/{repo}/-/archive/{ref}/source.tar.gz"
    else:
        tarball_url = f"https://codeload.github.com/{repo}/tar.gz/{ref}"
    tmp_tar = dest + ".tgz"
    try:
        os_download(tarball_url, tmp_tar)
        os.makedirs(dest, exist_ok=True)
        with tarfile.open(tmp_tar, "r:gz") as t:
            # 去掉顶层目录
            members = t.getmembers()
            top = members[0].name.split("/")[0] if members else None
            safe_extract_members(t, dest, top)
        manifest(f"{label}: fetched {host}/{repo}@{ref} (tarball)")
        return dest
    except Exception as e:  # noqa: BLE001
        log(f"tarball fetch failed ({e}); falling back to git clone")
    finally:
        if os.path.isfile(tmp_tar):
            try:
                os.remove(tmp_tar)
            except OSError:
                pass
    url = f"https://{host}/{repo}.git"
    run(["git", "clone", "-q", "--depth=1", "--no-single-branch", "-b", branch, url, dest])
    if sha:
        rc, _ = run(["git", "fetch", "--depth=1", "origin", sha], cwd=dest, check=False, capture=True)
        if rc != 0:
            fail(f"{label}: 无法在该克隆中解析 SHA {sha}")
        run(["git", "checkout", "-q", sha], cwd=dest)
    manifest(f"{label}: fetched {host}/{repo}@{ref} (git clone)")
    return dest


def safe_extract_members(tar, dest, top):
    for m in tar.getmembers():
        name = m.name.replace("\\", "/")
        if name.startswith("/") or ".." in name.split("/"):
            raise RuntimeError(f"unsafe tar member: {m.name}")
        if top and name == top:
            continue
        if top and name.startswith(top + "/"):
            m2 = m
            m2.name = name[len(top) + 1:]
            tar.extract(m2, dest)
        elif not top:
            tar.extract(m, dest)


def clone_kernelsu(repo, branch, ref, dest):
    """克隆 KernelSU 变体仓库到 dest；ref 可为分支/标签/SHA。"""
    if os.path.isdir(dest):
        shutil.rmtree(dest)
    url = f"https://github.com/{repo}.git"
    if ref and len(ref) == 40 and all(c in "0123456789abcdef" for c in ref):
        run(["git", "clone", "-q", "--depth=1", "--no-single-branch", url, dest])
        rc, out = run(["git", "fetch", "--depth=1", "origin", ref], cwd=dest, check=False, capture=True)
        if rc != 0:
            fail(f"KernelSU: 无法解析 SHA {ref}\n{out[-500:]}")
        run(["git", "checkout", "-q", ref], cwd=dest)
    elif ref:
        run(["git", "clone", "-q", "--depth=1", "--no-single-branch", "-b", ref, url, dest])
    else:
        run(["git", "clone", "-q", "--depth=1", "--no-single-branch", "-b", branch, url, dest])
    rc, out = run(["git", "rev-parse", "HEAD"], cwd=dest, capture=True)
    return out.strip()


# ---------------------------------------------------------------------------
# 补丁应用（GNU patch；审计 .rej/.orig 移出树，不删除）
# ---------------------------------------------------------------------------


def apply_with_harvest(patch_path, tree, fuzz, tag, audit_root, expect_clean=True):
    """应用补丁。返回 (rc, rejects[以 .rej 为准], fuzz_count, output)。"""
    log(f"apply patch: {os.path.basename(patch_path)} (fuzz={fuzz})")
    rc, out = run(["patch", "-p1", "--batch", f"--fuzz={fuzz}", "--forward", "-i", patch_path],
                  cwd=tree, check=False, capture=True)
    fuzz_count = out.count("with fuzz")
    rejects, artifacts, moved = [], [], []
    for root, _dirs, files in os.walk(tree):
        for f in files:
            rel = os.path.relpath(os.path.join(root, f), tree).replace("\\", "/")
            if f.endswith(".rej"):
                rejects.append(rel[: -len(".rej")])  # 记录目标文件路径（不含 .rej）
                moved.append(rel)
            elif f.endswith(".orig"):
                artifacts.append(rel[: -len(".orig")])
                moved.append(rel)
    if moved:
        audit = os.path.join(audit_root, tag)
        os.makedirs(audit, exist_ok=True)
        for rel in moved:
            src = os.path.join(tree, rel)
            dst = os.path.join(audit, rel.replace("/", "__"))
            if os.path.isfile(src):
                shutil.move(src, dst)
        log(f"  -> rejects: {rejects or 'none'} | fuzz backups: {len(artifacts)} moved to audit/{tag}/")
    if out.strip():
        tail = "\n".join(out.strip().splitlines()[-5:])
        log("  patch output tail:\n    " + tail.replace("\n", "\n    "))
    return rc, rejects, fuzz_count, out


# ---------------------------------------------------------------------------
# defconfig / 杂项
# ---------------------------------------------------------------------------


def append_defconfig(kernel_common, lines, marker):
    df = os.path.join(kernel_common, "arch/arm64/configs/gki_defconfig")
    if not os.path.isfile(df):
        fail(f"defconfig 不存在: {df}")
        return
    with open(df, "a", encoding="utf-8") as f:
        f.write(f"\n# --- {marker} ---\n")
        for ln in lines:
            f.write(ln.rstrip() + "\n")


def ensure_lsm_in_defconfig(kernel_common):
    """BBG 要求 CONFIG_LSM 含 baseband_guard；defconfig 无该行时新增完整行。"""
    lsm = "baseband_guard"
    default_lsm = "landlock,lockdown,yama,loadpin,safesetid,selinux,smack,tomoyo,apparmor,bpf"
    df = os.path.join(kernel_common, "arch/arm64/configs/gki_defconfig")
    if not os.path.isfile(df):
        fail(f"defconfig 不存在: {df}")
        return
    raw = read_text(df)
    found = False
    out_lines = []
    for line in raw.splitlines():
        if line.startswith("CONFIG_LSM=") and not found:
            found = True
            val = line[len("CONFIG_LSM="):]
            if lsm not in [x.strip() for x in val.split(",")]:
                line = f"CONFIG_LSM={val},{lsm}" if val else f"CONFIG_LSM={lsm}"
                log(f"CONFIG_LSM 追加 {lsm}: {line}")
        out_lines.append(line)
    if not found:
        out_lines.append(f"CONFIG_LSM={default_lsm},{lsm}")
        log(f"CONFIG_LSM 新增完整行: CONFIG_LSM={default_lsm},{lsm}")
    with open(df, "w", encoding="utf-8") as f:
        f.write("\n".join(out_lines) + "\n")


def sed_file(pattern, replacement, path):
    run(["sed", "-i", f"s/{pattern}/{replacement}/", path])


def find_kernel_common(base):
    cand = os.path.join(base, "kernel_platform", "common")
    if os.path.isdir(cand):
        return cand
    cand2 = os.path.join(base, "common")
    if os.path.isdir(cand2):
        return cand2
    fail(f"无法定位内核树 kernel_platform/common（cwd={base}）")
    return None


def get_kernel_version(kernel_common):
    ver = patch = sublev = ""
    with open(os.path.join(kernel_common, "Makefile"), encoding="utf-8") as f:
        for line in f:
            s = line.strip()
            if s.startswith("VERSION"):
                ver = s.split("=")[1].strip()
            elif s.startswith("PATCHLEVEL"):
                patch = s.split("=")[1].strip()
            elif s.startswith("SUBLEVEL"):
                sublev = s.split("=")[1].strip()
            elif s and not s.startswith("#"):
                break
    return f"{ver}.{patch}.{sublev}"


def find_patches_dir(script_dir, cwd):
    for cand in (os.path.join(cwd, "patches"),
                 os.path.join(script_dir, "patches"),
                 os.path.join(script_dir, "..", "patches")):
        if os.path.isdir(cand):
            return os.path.abspath(cand)
    return None


def load_pins(script_dir, cwd):
    pins = dict(DEFAULT_PINS)
    for cand in (os.path.join(cwd, "pins.env"),
                 os.path.join(script_dir, "pins.env"),
                 os.path.join(script_dir, "..", "pins.env")):
        if os.path.isfile(cand):
            log(f"pins loaded: {cand}")
            for line in open(cand, encoding="utf-8"):
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                pins[k.strip()] = v.strip()
            break
    for k in list(pins):
        if os.environ.get(k):
            pins[k] = os.environ[k]
    return pins


# ---------------------------------------------------------------------------
# 主流程
# ---------------------------------------------------------------------------


def build_parser():
    p = argparse.ArgumentParser(description=DESCRIPTION)
    p.add_argument("--ksu-variant", default="default", choices=list(KSU_VARIANTS.keys()),
                   help="Set KernelSU variant")
    p.add_argument("--ksu-branch", default="default",
                   help="Set the branch/tag/SHA of KernelSU to use (default: default)")
    p.add_argument("--susfs", action="store_true", help="Enable SUSFS support")
    p.add_argument("--with-bbg", action="store_true", help="Enable Baseband_guard support")
    p.add_argument("--mountify", action="store_true", help="Enable Mountify module support")
    p.add_argument("--fengchi", action="store_true", help="Setup fengchi patch")
    p.add_argument("--no-ver-edit", action="store_true", help="Disable version edit in gki_defconfig")
    p.add_argument("--kpm", action="store_true", help="Enable KPM module support (KPatch-Next post-build; all KSU variants)")
    p.add_argument("--kpm-patch", default=None, help="Path to Image that needs to be patched with KPM")
    p.add_argument("--multi-manager", action="store_false", default=True,
                   help="Disable Multi manager Support (ReSukiSU only)")
    p.add_argument("--droidspace", action="store_true", help="Enable Droidspace-OSS features")
    p.add_argument("--ntsync", action="store_true", help="Enable NTSync features")
    p.add_argument("--hookless", action="store_true", help="Enable Hookless features(ReSukiSU only)")
    p.add_argument("--zram", default="DISABLE", choices=["DISABLE", "LZ4", "LZ4KD"],
                   help="Upgrade ZRAM support")
    p.add_argument("--dry-run", action="store_true",
                   help="只校验环境并打印计划（不做任何网络/修改动作）")
    p.add_argument("--allow-degraded", action="store_true",
                   help="关键步骤失败时降级为警告（排障用，默认关闭）")
    return p


def main(argv=None):
    global ALLOW_DEGRADED
    args = build_parser().parse_args(argv)
    ALLOW_DEGRADED = args.allow_degraded

    script_dir = os.path.dirname(os.path.abspath(__file__))
    base = os.getcwd()
    log(f"configure v{CONFIGURE_VERSION} | cwd={base}")

    kernel_common = find_kernel_common(base)
    kver = get_kernel_version(kernel_common)
    variant = args.ksu_variant.upper()
    vinfo = KSU_VARIANTS.get(variant) or KSU_VARIANTS["default"]
    pins = load_pins(script_dir, base)
    patches_dir = find_patches_dir(script_dir, base)
    audit_root = os.path.join(base, "patch_audit")

    log(f"kernel version: {kver} | variant: {variant} | patches dir: {patches_dir}")
    manifest(f"configure v{CONFIGURE_VERSION} | kernel {kver} | variant {variant} | cwd {base}")

    # 启动摘要（与闭源行为对齐：动作前打印配置摘要块）
    zram_upper = args.zram.upper()
    log("Kernel Configuration Summary")
    log("-----------------------------")
    for label, val in (
        ("Kernel Version", kver), ("KernelSU Variant", variant), ("KSU Branch", args.ksu_branch),
        ("Hookless Support", "Enabled" if args.hookless else "Disabled"),
        ("SUSFS Support", "Enabled" if args.susfs else "Disabled"),
        ("Baseband_guard Support", "Enabled" if args.with_bbg else "Disabled"),
        ("Mountify Support", "Enabled" if args.mountify else "Disabled"),
        ("Fengchi", "Enabled" if args.fengchi else "Disabled"),
        ("KPM Support", "Enabled" if args.kpm else "Disabled"),
        ("Multi Manager Support", "Disabled" if not args.multi_manager else "Enabled"),
        ("Droidspace-OSS", "Enabled" if args.droidspace else "Disabled"),
        ("NTSync", "Enabled" if args.ntsync else "Disabled"),
        ("ZRAM Option", zram_upper),
        ("Version Edit in gki_defconfig", "Disabled" if args.no_ver_edit else "Enabled"),
    ):
        log(f"    {label}: {val}")

    if args.dry_run:
        log("[dry-run] 计划：")
        log(f"  - CVE 补丁: {raw_url('github.com', pins['KERNEL_PATCHES_REPO'], pins['KERNEL_PATCHES_SHA'] or 'master', 'other/fix-CVE-2026-43499.patch')}")
        log(f"  - KSU: {vinfo['repo']} ref={args.ksu_branch if args.ksu_branch != 'default' else (pins['KSU_REF'] or vinfo['branch'])}")
        if args.susfs:
            log(f"  - SUSFS: {pins['SUSFS_HOST']}/{pins['SUSFS_REPO']}@{pins['SUSFS_SHA'] or pins['SUSFS_BRANCH']} "
                f"(spec={SUSFS_SPEC.get(kver, 'UNSUPPORTED')})")
        if args.zram.upper() != "DISABLE":
            log(f"  - ZRAM {args.zram.upper()}: "
                f"{raw_url('github.com', pins['KERNEL_PATCHES_REPO'], pins['KERNEL_PATCHES_SHA'] or 'master', 'other/lib-Update-zram-to-1.10.0-6.6.118.patch')} "
                f"(spec={ZRAM_LZ4_SPEC.get(kver, 'UNSUPPORTED') if args.zram.upper() == 'LZ4' else 'LZ4KD'})")
        if args.kpm:
            log(f"  - KPM: {pins['KPATCH_REPO']}@{pins['KPATCH_TAG'] or 'latest'} (post-build Image patch, "
                f"CONFIG_KALLSYMS_ALL 断言)")
        log("  - defconfig 追加: " + ", ".join(CONTAINER_CONFIGS))
        log("[dry-run] 完成（未做任何修改）")
        return 0

    # ---- 1) 常驻补丁：CVE（+ 6.6.118 显示修复）----------------------------
    pd = os.path.join(base, "patches_download")
    os.makedirs(pd, exist_ok=True)
    kp_ref = pins["KERNEL_PATCHES_SHA"] or "master"
    kp_repo = pins["KERNEL_PATCHES_REPO"]

    def kp_raw(path):
        return raw_url("github.com", kp_repo, kp_ref, path)

    cve = os.path.join(pd, "fix-CVE-2026-43499.patch")
    try:
        os_download(kp_raw("other/fix-CVE-2026-43499.patch"), cve)
        rc, rejs, _fz, _o = apply_with_harvest(cve, kernel_common, 2, "cve", audit_root)
        if rc != 0 or rejs:
            warn(f"CVE 补丁未干净应用 (rc={rc}, rejects={rejs})")
        else:
            manifest("patch fix-CVE-2026-43499.patch -> OK")
    except Exception as e:  # noqa: BLE001
        warn(f"CVE 补丁获取/应用失败: {e}")

    if kver == "6.6.118":
        disp = os.path.join(pd, "fix_display_for_118.patch")
        try:
            os_download(kp_raw("other/fix_display_for_118.patch"), disp)
            rc, rejs, _fz, _o = apply_with_harvest(disp, kernel_common, 2, "display118", audit_root)
            if rc != 0 or rejs:
                warn(f"display118 补丁未干净应用 (rc={rc}, rejects={rejs})")
            else:
                manifest("patch fix_display_for_118.patch -> OK")
        except Exception as e:  # noqa: BLE001
            warn(f"display118 补丁获取/应用失败: {e}")

    # ---- 2) KernelSU 变体注入 -------------------------------------------
    ksu_ref = pins["KSU_REF"] if args.ksu_branch == "default" else args.ksu_branch
    if not ksu_ref and args.susfs and vinfo.get("susfs_branch"):
        ksu_ref = vinfo["susfs_branch"]
        log(f"SUSFS 模式：{variant} 使用集成分支 {ksu_ref}（依据闭源行为基线 §2）")
    if variant in ("RESUKISU", "RKSU", "SUKISU", "NEXT"):
        # 已验证路径：直接克隆到内核树内 KernelSU/，再执行其 setup.sh
        ksu_dest = os.path.join(kernel_common, "KernelSU")
        resolved = clone_kernelsu(vinfo["repo"], vinfo["branch"], ksu_ref, ksu_dest)
        manifest(f"KSU {variant}: {vinfo['repo']} ref={ksu_ref or vinfo['branch']} resolved={resolved}")
        setup = os.path.join(ksu_dest, "kernel", "setup.sh")
        if not os.path.isfile(setup):
            fail(f"KernelSU setup.sh 不存在: {setup}")
        rc, out = run(["bash", "KernelSU/kernel/setup.sh", ksu_ref or vinfo["branch"]],
                      cwd=kernel_common, check=False, capture=True)
        if rc != 0:
            fail(f"KernelSU setup.sh 失败 (rc={rc})\n{out[-1500:]}")
        log("KernelSU setup.sh OK")
    else:
        # 旧世代变体：保持以往的"工作区克隆 + setup.sh"方式（best-effort）
        ksu_dest = os.path.join(base, "KernelSU")
        resolved = clone_kernelsu(vinfo["repo"], vinfo["branch"], ksu_ref, ksu_dest)
        manifest(f"KSU {variant}: {vinfo['repo']} ref={ksu_ref or vinfo['branch']} resolved={resolved}")
        setup = os.path.join(ksu_dest, "kernel", "setup.sh")
        if os.path.isfile(setup):
            rc, out = run(["bash", setup], cwd=kernel_common, check=False, capture=True)
            if rc != 0:
                warn(f"KernelSU setup.sh 失败 (rc={rc}) —— 该变体路径未经验证\n{out[-800:]}")
        else:
            warn(f"KernelSU setup.sh 不存在: {setup}")

    # 断言：内核树里的 kernelsu 接线
    drv_link = os.path.join(kernel_common, "drivers", "kernelsu")
    if not os.path.exists(drv_link):
        fail("drivers/kernelsu 链接不存在 —— KernelSU 未接入内核树")
    if not grep_count(os.path.join(kernel_common, "drivers/Makefile"), "kernelsu"):
        fail("drivers/Makefile 缺少 kernelsu 条目")
    if not grep_count(os.path.join(kernel_common, "drivers/Kconfig"), "drivers/kernelsu/Kconfig"):
        fail("drivers/Kconfig 缺少 kernelsu 条目")

    # ---- 3) SUSFS --------------------------------------------------------
    susfs_version = None
    if args.susfs:
        spec = SUSFS_SPEC.get(kver)
        if spec is None:
            fail(f"SUSFS: 内核版本 {kver} 未配置（仅支持 {', '.join(SUSFS_SPEC)}）")
        src = fetch_source_tree(pins["SUSFS_HOST"], pins["SUSFS_REPO"], pins["SUSFS_BRANCH"],
                                pins["SUSFS_SHA"], os.path.join(base, "SUSFS"), "SUSFS")
        kp_src = os.path.join(src, "kernel_patches")
        if not os.path.isdir(kp_src):
            fail(f"SUSFS 源缺少 kernel_patches/: {src}")

        # 1) 拷贝 fs/ 与 include/
        fs_src = os.path.join(kp_src, "fs")
        inc_src = os.path.join(kp_src, "include")
        if not os.path.isdir(fs_src) or not os.path.isdir(inc_src):
            fail("SUSFS 源缺少 kernel_patches/{fs,include}")
        for root, _d, files in os.walk(fs_src):
            for f in files:
                rel = os.path.relpath(os.path.join(root, f), fs_src)
                dst = os.path.join(kernel_common, "fs", rel)
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                shutil.copyfile(os.path.join(root, f), dst)
        for root, _d, files in os.walk(inc_src):
            for f in files:
                rel = os.path.relpath(os.path.join(root, f), inc_src)
                dst = os.path.join(kernel_common, "include", rel)
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                shutil.copyfile(os.path.join(root, f), dst)
        for need in ("fs/susfs.c", "include/linux/susfs.h", "include/linux/susfs_def.h"):
            if not os.path.isfile(os.path.join(kernel_common, need)):
                fail(f"SUSFS 文件拷贝缺失: {need}")

        # 2) 应用 50_ 启用补丁
        cands = sorted(f for f in os.listdir(kp_src)
                       if f.startswith("50_") and f.endswith(".patch"))
        if not cands:
            fail("SUSFS 源中未找到 50_*.patch")
        patch50 = os.path.join(kp_src, cands[0])
        rc, rejs, fz, _o = apply_with_harvest(patch50, kernel_common, spec["fuzz"], "susfs50", audit_root)

        # 3) 残留拒绝：6.6.89 需 fixup；6.6.118 必须为零
        unexpected = [r for r in rejs if r not in spec["expected_rejects"]]
        if unexpected:
            fail(f"SUSFS 50_ 出现预期外的 rejects: {unexpected}")
        if spec["fixup"]:
            if not patches_dir:
                fail(f"缺少 patches/ 目录（需要 {spec['fixup']}）")
            fixup = os.path.join(patches_dir, spec["fixup"])
            if not os.path.isfile(fixup):
                fail(f"缺少修补补丁: {fixup}")
            rc2, rejs2, _fz2, out2 = apply_with_harvest(fixup, kernel_common, 0, "susfs89fixup", audit_root)
            if rc2 != 0 or rejs2:
                fail(f"89-susfs-fixup 应用失败 (rc={rc2}, rejects={rejs2})\n{out2[-800:]}")
            manifest(f"patch {spec['fixup']} -> OK (覆盖残留 include hunk: {sorted(set(rejs)) or 'none'})")
        elif rejs:
            fail(f"SUSFS 50_ 未干净应用: {rejs}")
        manifest(f"patch {cands[0]} -> OK (fuzz_applied={fz}, expected_rejects={sorted(spec['expected_rejects'])})")

        # 4) 完整性断言
        for rel, needle, n in SUSFS_ASSERTS:
            c = grep_count(os.path.join(kernel_common, rel), needle)
            if c < n:
                fail(f"SUSFS 断言失败: {rel} 缺少 {needle} (found {c})")
        if not grep_count(os.path.join(kernel_common, "fs/Makefile"), "susfs"):
            fail("fs/Makefile 未接线 susfs（50_ 补丁未生效）")

        # 5) KernelSU 侧：ReSukiSU 系内置支持；旧世代变体尝试 10_ 补丁（best-effort）
        ksu_kconfig = os.path.join(kernel_common, "KernelSU", "kernel", "Kconfig")
        if vinfo["manual_susfs"]:
            p10 = os.path.join(kp_src, "KernelSU", "10_enable_susfs_for_ksu.patch")
            if os.path.isfile(p10) and os.path.isdir(os.path.join(kernel_common, "KernelSU")):
                rc10, rejs10, _fz10, _o10 = apply_with_harvest(p10, os.path.join(kernel_common, "KernelSU"),
                                                               1, "ksu10", audit_root)
                if rc10 != 0 or rejs10:
                    warn(f"变体 {variant} 的 KernelSU 侧 10_ 补丁未干净应用（该变体路径未验证）")
                else:
                    manifest("patch 10_enable_susfs_for_ksu.patch -> OK")
        else:
            if not grep_count(ksu_kconfig, "config KSU_SUSFS"):
                fail(f"变体 {variant} 的 KernelSU 缺少内置 SUSFS 支持（Kconfig 无 KSU_SUSFS）")
            log(f"variant {variant}: KernelSU 内置 SUSFS 支持，跳过 10_ 补丁（按设计）")
            manifest("KSU-side susfs: builtin (no 10_ patch applied)")

        # 6) defconfig 启用
        append_defconfig(kernel_common, ["CONFIG_KSU_SUSFS=y"], "SUSFS")
        m = read_text(os.path.join(kernel_common, "include/linux/susfs.h"))
        for ln in m.splitlines():
            if ln.startswith("#define SUSFS_VERSION"):
                susfs_version = ln.split('"')[1] if '"' in ln else ln.split()[-1]
        manifest(f"SUSFS version: {susfs_version}")
        log(f"SUSFS integrated (version={susfs_version})")
    else:
        append_defconfig(kernel_common, ["CONFIG_KSU_SUSFS=n"], "SUSFS disabled")

    # ---- 4) 版本号改写 / multi-manager ----------------------------------
    if not args.no_ver_edit:
        append_defconfig(
            kernel_common,
            ['CONFIG_KSU_FULL_NAME_FORMAT="%TAG_NAME%-%COMMIT_SHA%@%REPO_NAME%"'],
            "version format")
        log("Version edit injected into gki_defconfig")
    else:
        log("Version edit disabled (--no-ver-edit)")

    mm_val = "y" if args.multi_manager else "n"
    append_defconfig(kernel_common, [f"CONFIG_KSU_MULTI_MANAGER_SUPPORT={mm_val}"], "multi-manager")

    # ---- 5) ZRAM ---------------------------------------------------------
    zram = args.zram.upper()
    if zram == "LZ4":
        append_defconfig(kernel_common, ["CONFIG_ZRAM=y", "CONFIG_ZRAM_WRITEBACK=y"], "zram-lz4")
        spec = ZRAM_LZ4_SPEC.get(kver)
        if spec is None:
            fail(f"ZRAM LZ4: 内核版本 {kver} 未配置（仅支持 {', '.join(ZRAM_LZ4_SPEC)}）")
        try:
            pl = os.path.join(pd, "lib-update-zram.patch")
            os_download(kp_raw("other/lib-Update-zram-to-1.10.0-6.6.118.patch"), pl)
        except Exception as e:  # noqa: BLE001
            fail(f"ZRAM LZ4 补丁下载失败: {e}")
        # 与闭源 118 行为一致：lib-Update 单补丁、fuzz=0、raw 字节；89 的树差异由 fixup + 显式删除收敛。
        rc, rejs, _fz, _o = apply_with_harvest(pl, kernel_common, 0, "zram-lz4", audit_root)
        unexpected = [x for x in rejs if x not in spec["expected_rejects"]]
        if unexpected:
            fail(f"ZRAM LZ4 出现预期外的 rejects: {unexpected} (rc={rc})")
        if spec["fixup"]:
            if not patches_dir:
                fail(f"缺少 patches/ 目录（需要 {spec['fixup']}）")
            fx = os.path.join(patches_dir, spec["fixup"])
            if not os.path.isfile(fx):
                fail(f"缺少修补补丁: {fx}")
            rc2, rejs2, _f2, out2 = apply_with_harvest(fx, kernel_common, 0, "zramlz489fixup", audit_root)
            if rc2 != 0 or rejs2:
                fail(f"{spec['fixup']} 应用失败 (rc={rc2}, rejects={rejs2})\n{out2[-600:]}")
            manifest(f"patch {spec['fixup']} -> OK (覆盖残留 hunk: {sorted(set(rejs)) or 'none'})")
        elif rc != 0 or rejs:
            fail(f"ZRAM LZ4 补丁未干净应用 (rc={rc}, rejects={rejs})")
        # lib/lz4/lz4hc.c 依赖环境提供 MIN/MAX（6.6.89 树无、较新树有厂商版）；
        # lz4.c 里的定义在该翻译单元（LZ4_COMMONDEFS_ONLY 模式）不生效 →
        # 打上带守卫的兜底定义（对已提供该宏的树为 no-op）。
        ff = os.path.join(patches_dir, "lz4hc-minmax-fixup.patch") if patches_dir else None
        if not ff or not os.path.isfile(ff):
            fail("缺少修补补丁: lz4hc-minmax-fixup.patch")
        rc3, rejs3, _f3, out3 = apply_with_harvest(ff, kernel_common, 0, "lz4hc-minmax", audit_root)
        if rc3 != 0 or rejs3:
            fail(f"lz4hc-minmax-fixup 应用失败 (rc={rc3}, rejects={rejs3})\n{out3[-600:]}")
        if "ifndef MIN" not in read_text(os.path.join(kernel_common, "lib/lz4/lz4hc.c")):
            fail("lz4hc-minmax-fixup 未生效（MIN 兜底缺失）")
        manifest("patch lz4hc-minmax-fixup.patch -> OK (MIN/MAX 兜底；对提供该宏的树为 no-op)")
        # 89 差异：旧版 lib/lz4/lz4hc_compress.c 与补丁删除块内容不符（删除无法应用）——
        # 由我们显式移除；功能上它正是被新 lib/lz4/lz4hc.c 取代的旧实现。
        hc = os.path.join(kernel_common, "lib/lz4/lz4hc_compress.c")
        if os.path.isfile(hc):
            os.remove(hc)
            manifest("removed lib/lz4/lz4hc_compress.c (superseded; patch 删除块内容差异)")
        # 终态断言（防"半应用"再次溜进编译期）
        for rel, want in (("lib/lz4/lz4armv8/lz4accel.c", True), ("lib/lz4/lz4armv8/lz4accel.h", True),
                          ("lib/lz4/lz4armv8/lz4armv8.S", True), ("lib/lz4/lz4.c", True),
                          ("lib/lz4/lz4hc.c", True), ("lib/lz4/lz4.h", True), ("lib/lz4/lz4hc.h", True),
                          ("lib/lz4/lz4_compress.c", False), ("lib/lz4/lz4_decompress.c", False),
                          ("lib/lz4/lz4defs.h", False), ("lib/lz4/lz4hc_compress.c", False)):
            ex = os.path.exists(os.path.join(kernel_common, rel))
            if ex != want:
                fail(f"ZRAM LZ4 终态断言失败: {rel} exists={ex} want={want}")
        if not grep_count(os.path.join(kernel_common, "fs/f2fs/compress.c"), "LZ4_arm64_decompress_safe"):
            fail("ZRAM LZ4: fs/f2fs/compress.c 未包含 LZ4_arm64_decompress_safe（补丁未生效）")
        manifest(f"patch lib-Update-zram-to-1.10.0-6.6.118.patch -> OK (fuzz=0, expected_rejects={sorted(spec['expected_rejects'])})")
    elif zram == "LZ4KD":
        append_defconfig(kernel_common, ["CONFIG_ZRAM=y", "CONFIG_ZRAM_LZ4KD=y"], "zram-lz4kd")
        try:
            p1 = os.path.join(pd, "lz4kd.patch")
            os_download(kp_raw("other/lz4kd.patch"), p1)
            rc, rejs, _fz, _o = apply_with_harvest(p1, kernel_common, 3, "lz4kd", audit_root)
            if rc != 0 or rejs:
                warn(f"LZ4KD 补丁未干净应用 (rc={rc}, rejects={rejs})")
            else:
                manifest("patch lz4kd.patch -> OK")
        except Exception as e:  # noqa: BLE001
            warn(f"LZ4KD 补丁获取失败: {e}")
    if zram == "LZ4KD" and kver == "6.6.118":
        try:
            p2 = os.path.join(pd, "lib-update-zram-118.patch")
            os_download(kp_raw("other/lib-Update-zram-to-1.10.0-6.6.118.patch"), p2)
            rc, rejs, _fz, _o = apply_with_harvest(p2, kernel_common, 3, "zram-lib118", audit_root)
            if rc != 0 or rejs:
                warn("zram 库升级补丁未干净应用")
            else:
                manifest("patch lib-Update-zram-to-1.10.0-6.6.118.patch -> OK")
        except Exception as e:  # noqa: BLE001
            warn(f"zram 库升级补丁失败: {e}")

    # ---- 6) BBG（关键，启用时严格）-------------------------------------
    if args.with_bbg:
        bbg_dir = os.path.join(kernel_common, "Baseband-guard")
        bbg_ref = pins["BBG_REF"]
        clone_kernelsu(pins["BBG_REPO"], "main", bbg_ref, bbg_dir)  # 复用同一克隆逻辑
        setup = os.path.join(bbg_dir, "setup.sh")
        if not os.path.isfile(setup):
            fail("Baseband-guard setup.sh 缺失")
        rc, out = run(["bash", "Baseband-guard/setup.sh", bbg_ref] if bbg_ref
                      else ["bash", "Baseband-guard/setup.sh"], cwd=kernel_common, check=False, capture=True)
        if rc != 0:
            fail(f"Baseband-guard setup.sh 失败 (rc={rc})\n{out[-800:]}")
        append_defconfig(kernel_common, ["CONFIG_BBG=y"], "BBG")
        ensure_lsm_in_defconfig(kernel_common)
        kcfg = os.path.join(kernel_common, "security", "Kconfig")
        if os.path.isfile(kcfg):
            sed_expr = ("/^config LSM$/,/^help$/{ "
                        "/^[[:space:]]*default/ { /baseband_guard/! s/selinux/selinux,baseband_guard/ } }")
            run(["sed", "-i", sed_expr, kcfg], cwd=kernel_common)
            log("security/Kconfig: CONFIG_LSM default 注入 baseband_guard")
        # BBG 构建期 $(error) 防线断言
        if not os.path.exists(os.path.join(kernel_common, "security", "baseband-guard")):
            fail("security/baseband-guard 链接/目录不存在（BBG 未接入）")
        if "baseband_guard" not in read_text(kcfg):
            fail("security/Kconfig 未包含 baseband_guard")
        if "CONFIG_BBG=y" not in read_text(os.path.join(kernel_common, "arch/arm64/configs/gki_defconfig")):
            fail("defconfig 未写入 CONFIG_BBG=y")
        manifest("BBG: setup OK + defconfig LSM + security/Kconfig default OK")

    # ---- 7) 可选功能（降级记录，不阻断）--------------------------------
    if args.mountify:
        append_defconfig(kernel_common, ["CONFIG_OVERLAY_FS=y", "CONFIG_TMPFS_XATTR=y"], "mountify")
        manifest("mountify: CONFIG_OVERLAY_FS=y + CONFIG_TMPFS_XATTR=y")
    if args.fengchi:
        p = kp_raw("other/fengchi_oneplus_ace_6_118.patch" if kver == "6.6.118"
                   else "other/fengchi_oneplus_ace_6_89.patch")
        try:
            d = os.path.join(pd, "fengchi.patch")
            os_download(p, d)
            rc, rejs, _fz, _o = apply_with_harvest(d, kernel_common, 3, "fengchi", audit_root)
            if rc != 0 or rejs:
                warn(f"fengchi 补丁未干净应用 (rejects={rejs})")
            else:
                manifest("patch fengchi -> OK")
        except Exception as e:  # noqa: BLE001
            warn(f"fengchi 失败: {e}")
    if args.droidspace:
        try:
            d = os.path.join(pd, "droidspace.patch")
            os_download(kp_raw("other/droidspace.patch"), d)
            rc, rejs, _fz, _o = apply_with_harvest(d, kernel_common, 3, "droidspace", audit_root)
            if rc != 0 or rejs:
                warn(f"droidspace 补丁未干净应用 (rejects={rejs})")
            else:
                manifest("patch droidspace -> OK")
                # netns 修复：droidspace 的 out_free_2 标签在「KEYS=y & NF_TABLES=n」组合下
                # unused（-Werror 编译失败）；修补为"标签随任一路径存在 + KEYS 失败改跳 out_free_2"
                # （四种配置组合均可编译，语义不变）。
                fx = os.path.join(patches_dir, "droidspace-netns-fixup.patch") if patches_dir else None
                if not fx or not os.path.isfile(fx):
                    fail("缺少修补补丁: droidspace-netns-fixup.patch")
                rc2, rejs2, _f2, out2 = apply_with_harvest(fx, kernel_common, 0, "droidspace-netns", audit_root)
                if rc2 != 0 or rejs2:
                    fail(f"droidspace-netns-fixup 应用失败 (rc={rc2}, rejects={rejs2})\n{out2[-600:]}")
                nn = read_text(os.path.join(kernel_common, "net/core/net_namespace.c"))
                if "out_free_3" in nn or "#if !defined(CONFIG_KEYS)\nout_free_2:" in nn:
                    fail("droidspace-netns-fixup 未生效（netns 标签修复缺失）")
                manifest("patch droidspace-netns-fixup.patch -> OK (netns 标签四组合可编译)")
        except Exception as e:  # noqa: BLE001
            warn(f"droidspace 失败: {e}")
    if args.ntsync:
        append_defconfig(kernel_common, ["CONFIG_NTSYNC=y"], "ntsync")
        try:
            nref = pins["NTSC_SHA"] or "main"
            b = os.path.join(pd, "ntsync_base.patch")
            c = os.path.join(pd, "ntsync_compat.patch")
            os_download(raw_url("github.com", pins["NTSC_REPO"], nref, "NTsync/ntsync_base.patch"), b)
            os_download(raw_url("github.com", pins["NTSC_REPO"], nref, "NTsync/ntsync_compat_android15-6.6.patch"), c)
            for tag, f in (("ntsync-base", b), ("ntsync-compat", c)):
                rc, rejs, _fz, _o = apply_with_harvest(f, kernel_common, 3, tag, audit_root)
                if rc != 0 or rejs:
                    warn(f"{tag} 补丁未干净应用 (rejects={rejs})")
                else:
                    manifest(f"patch {os.path.basename(f)} -> OK")
        except Exception as e:  # noqa: BLE001
            warn(f"ntsync 失败: {e}")
    if args.hookless:
        # URL 修复：两个补丁在仓库根目录（旧版误加 other/ 前缀，404）
        for tag, path in (
            ("hookless-manual", "manual_hook/kernel-gki.patch"),
            ("hookless-scope", "scope-miniminzed/scope-minnimized-hooks-v1.9.patch"),
        ):
            try:
                d = os.path.join(pd, os.path.basename(path))
                os_download(kp_raw(path), d)
                rc, rejs, _fz, _o = apply_with_harvest(d, kernel_common, 3, tag, audit_root)
                if rc != 0 or rejs:
                    warn(f"{tag} 未干净应用 (rejects={rejs})")
                else:
                    manifest(f"patch {path} -> OK")
            except Exception as e:  # noqa: BLE001
                warn(f"{tag} 失败: {e}")
        try:
            d = os.path.join(pd, "syscall_hooks.patch")
            os_download(raw_url("github.com", pins["SUKI_HOOKS_REPO"], "main", "hooks/syscall_hooks.patch"), d)
            rc, rejs, _fz, _o = apply_with_harvest(d, kernel_common, 3, "suki-hooks", audit_root)
            if rc != 0 or rejs:
                warn("suki syscall hooks 未干净应用")
            else:
                manifest("patch syscall_hooks.patch -> OK")
        except Exception as e:  # noqa: BLE001
            warn(f"suki hooks 失败: {e}")
    if args.kpm:
        # KPatch-Next 后置注入（release tag 由 pins 钉死；置空 = 解析最新 release）
        kpatch_tag = pins["KPATCH_TAG"]
        if not kpatch_tag:
            # latest 分支模式：跟随最新 release
            try:
                req = urllib.request.Request(
                    f"https://api.github.com/repos/{pins['KPATCH_REPO']}/releases/latest",
                    headers={"User-Agent": "ace6-configure", "Accept": "application/vnd.github+json"})
                kpatch_tag = json.loads(urllib.request.urlopen(req, timeout=30).read().decode())["tag_name"]
                manifest(f"KPM: KPATCH_TAG 为空 -> 解析最新 release = {kpatch_tag}")
            except Exception as e:  # noqa: BLE001
                fail(f"KPM: 解析最新 release 失败（KPATCH_TAG 置空时需可达 api.github.com）: {e}")
        kptools = os.path.join(base, "kptools-linux")
        kpimg = os.path.join(base, "kpimg-linux")
        rel_base = f"https://github.com/{pins['KPATCH_REPO']}/releases/download/{kpatch_tag}"
        try:
            os_download(f"{rel_base}/kptools-linux", kptools)
            os_download(f"{rel_base}/kpimg-linux", kpimg)
            os.chmod(kptools, 0o755)
            manifest(f"KPM: KPatch-Next {kpatch_tag} tools ({pins['KPATCH_REPO']}) downloaded")
        except Exception as e:  # noqa: BLE001
            fail(f"KPM 工具下载失败: {e}")
        # KPatch-Next 要求内核启用 KALLSYMS（建议同时 KALLSYMS_ALL）——断言兜底
        dfk = os.path.join(kernel_common, "arch/arm64/configs/gki_defconfig")
        if "CONFIG_KALLSYMS_ALL=y" not in read_text(dfk):
            fail("KPM: gki_defconfig 缺少 CONFIG_KALLSYMS_ALL=y（KPatch-Next 需要）")
        if args.kpm_patch:
            img = os.path.abspath(args.kpm_patch)
            if not os.path.isfile(img):
                fail(f"Image not found: {img}")
            if os.path.basename(img) != "Image":
                fail(f"Image file name must be 'Image', got '{os.path.basename(img)}'")
            out_img = img + ".kpm"
            rc, out = run([kptools, "-p", "-i", img, "-k", kpimg, "-o", out_img], cwd=base, check=False, capture=True)
            if rc != 0:
                fail(f"KPM Image 补丁失败\n{out[-500:]}")
            os.replace(out_img, img)
            manifest("KPM(Image) patched (KPatch-Next)")

    # ---- 8) defconfig 统一 sed ------------------------------------------
    df = os.path.join(kernel_common, "arch/arm64/configs/gki_defconfig")
    if os.path.isfile(df):
        sed_file("-4k", "", df)
        sed_file("CONFIG_ZRAM=m", "CONFIG_ZRAM=y", df)
        # 容器/运行时配置（与闭源 configure 行为对齐）：
        # - 缺这些 → droidspace 等容器功能不完整；
        # - 且 KEYS=y & NF_TABLES=n 时 net/core/net_namespace.c 的 out_free_2 标签 unused（-Werror）。
        append_defconfig(kernel_common, list(CONTAINER_CONFIGS),
                         "container/runtime (parity with closed configure)")
        _dfc = read_text(df)
        _missing = [x for x in CONTAINER_CONFIGS if x not in _dfc]
        if _missing:
            fail(f"容器配置未写入 defconfig: {_missing}")
        manifest("defconfig: container/runtime 配置已追加 "
                 "(PID_NS/SYSVIPC/IPC_NS/POSIX_MQUEUE/DEVTMPFS/NF_TABLES/OVERLAY_FS/HEADERS_INSTALL)")

    # ---- 9) 摘要与清单 ---------------------------------------------------
    summary_lines = [
        f"Kernel Version: {kver}",
        f"KernelSU Variant: {variant}",
        f"KSU Branch: {args.ksu_branch}",
        f"Hookless Support: {'Enabled' if args.hookless else 'Disabled'}",
        f"SUSFS Support: {'Enabled (' + str(susfs_version) + ')' if args.susfs else 'Disabled'}",
        f"Baseband_guard Support: {'Enabled' if args.with_bbg else 'Disabled'}",
        f"Mountify Support: {'Enabled' if args.mountify else 'Disabled'}",
        f"Fengchi: {'Enabled' if args.fengchi else 'Disabled'}",
        f"KPM Support: {'Enabled' if args.kpm else 'Disabled'}",
        f"Multi Manager Support: {'Disabled' if not args.multi_manager else 'Enabled'}",
        f"Droidspace-OSS: {'Enabled' if args.droidspace else 'Disabled'}",
        f"NTSync: {'Enabled' if args.ntsync else 'Disabled'}",
        f"ZRAM Option: {zram}",
        f"Version Edit in gki_defconfig: {'Disabled' if args.no_ver_edit else 'Enabled'}",
        f"Degraded Items: {len(STATE['degraded'])}",
    ]
    with open(os.path.join(base, "config_summary.txt"), "w", encoding="utf-8") as f:
        f.write("\n".join(summary_lines) + "\n")

    with open(os.path.join(base, "build_manifest.txt"), "w", encoding="utf-8") as f:
        f.write(f"Build Manifest (configure v{CONFIGURE_VERSION})\n")
        f.write("=" * 60 + "\n")
        for line in STATE["manifest"]:
            f.write(line + "\n")
        if STATE["degraded"]:
            f.write("\n[degraded]\n")
            for d in STATE["degraded"]:
                f.write(f"- {d}\n")

    if STATE["degraded"]:
        log("以下是已记录的降级项（构建可继续，但请知悉）：")
        for d in STATE["degraded"]:
            log(f"  - {d}")
    log("Configuration completed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
